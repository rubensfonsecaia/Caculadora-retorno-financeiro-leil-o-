# Copie para .env.local e preencha com as SUAS chaves. Nunca faça commit do .env.local.
# Sem as duas variáveis do Supabase, o app roda em modo demonstração (localStorage).

# --- Público (vai para o navegador) ---
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço do site (links dos e-mails e retorno do Stripe). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Só no servidor ---
# Supabase: Project Settings > API > service_role. Ignora a RLS: só webhook, jobs e exclusão de conta.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (modo TESTE até o deploy): Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > o endpoint /api/stripe/webhook > Signing secret
# (local: `stripe listen --forward-to localhost:3000/api/stripe/webhook` mostra um whsec_)
STRIPE_WEBHOOK_SECRET=
# Product catalog > Pro > os dois preços (mensal e anual)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Resend: API Keys. EMAIL_FROM precisa ser do seu domínio verificado, ex.: "Nome <avisos@seudominio.com.br>"
RESEND_API_KEY=
EMAIL_FROM=
# Recebe o aviso mensal de CUB desatualizado
ADMIN_EMAIL=

# Segredo que a Vercel manda nos jobs agendados (16+ caracteres aleatórios)
CRON_SECRET=

# --- Só para scripts/seed.mjs (desenvolvimento) ---
SEED_PASSWORD=

# --- Só para `supabase start` (login com Google no ambiente local) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
